# Copy from Supabase Dashboard → Settings → API (same project for all three).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=your_legacy_anon_jwt_here

# Local: save as .env then restart `npm run dev`.
# Vercel/deploy: set the same vars in Project → Settings → Environment Variables, then Redeploy.
# ERR_NAME_NOT_RESOLVED usually means an old/wrong project URL is baked into the deployed build.
