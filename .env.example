# Copy from Supabase Dashboard → Settings → API (same project for all three).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_USE_PROXY=true
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=your_legacy_anon_jwt_here

# VITE_SUPABASE_USE_PROXY routes API calls through /api/supabase (fixes Chrome QUIC errors).
# Local: save as .env then restart `npm run dev`.
# Vercel: set env vars + update vercel.json proxy destination to match VITE_SUPABASE_URL, then redeploy.
